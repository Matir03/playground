diff --git a/src/mohex/MoHexEngine.cpp b/src/mohex/MoHexEngine.cpp
index 5ed1828..869a3ae 100644
--- a/src/mohex/MoHexEngine.cpp
+++ b/src/mohex/MoHexEngine.cpp
@@ -166,7 +166,31 @@ HexPoint MoHexEngine::GenMove(HexColor color, bool useGameClock)
     if (bookMove != INVALID_POINT)
         return bookMove;
     double maxTime = TimeForMove(color);
-    return DoSearch(color, maxTime);
+    HexPoint move = DoSearch(color, maxTime);
+
+    // Last line of defence: the move must be legal in the *game* board, not just
+    // in the search's fill-in-augmented copy. When they disagree -- reachable via
+    // subtree reuse across a clear_board+replay, which is how an automated driver
+    // feeds positions -- genmove answers with an occupied cell, the engine throws
+    // while reporting it, and the game is lost to the caller either way.
+    //
+    // These are already-decided, heavily filled-in positions, so substituting a
+    // legal cell costs nothing in strength; the alternative is not playing at all.
+    if (move != SWAP_PIECES && move != RESIGN)
+    {
+        const StoneBoard& pos = m_game.Board();
+        if (!HexPointUtil::isInteriorCell(move) || !pos.IsEmpty(move))
+        {
+            LogWarning() << "GenMove produced an illegal move (" << move
+                         << "); substituting a legal one\n";
+            HexPoint alt = BoardUtil::RandomEmptyCell(pos);
+            if (alt != INVALID_POINT)
+                return alt;
+            LogWarning() << "No empty cell remains; resigning\n";
+            return RESIGN;
+        }
+    }
+    return move;
 }
 
 HexPoint MoHexEngine::DoSearch(HexColor color, double maxTime)
diff --git a/src/mohex/MoHexPlayer.cpp b/src/mohex/MoHexPlayer.cpp
index 40fd6f9..a70c279 100644
--- a/src/mohex/MoHexPlayer.cpp
+++ b/src/mohex/MoHexPlayer.cpp
@@ -185,7 +185,21 @@ HexPoint MoHexPlayer::Search(const HexState& state, const Game& game,
     // move.
     LogWarning() << "**** MoHexSearch returned empty sequence!\n"
 		 << "**** Returning random move!\n";
-    return BoardUtil::RandomEmptyCell(brd.GetPosition());
+    // `brd` carries the ICE fill-in, and in a position proven won the fill-in
+    // can cover the whole board -- RandomEmptyCell then returns INVALID_POINT
+    // and the engine answers `genmove` with an illegal move. Fall back to the
+    // real position, preferring a cell from the consider set.
+    HexPoint fallback = BoardUtil::RandomEmptyCell(brd.GetPosition());
+    if (fallback == INVALID_POINT)
+    {
+        const StoneBoard& pos = state.Position();
+        bitset_t candidates = consider & pos.GetEmpty() & pos.Const().GetCells();
+        if (candidates.any())
+            fallback = static_cast<HexPoint>(BitsetUtil::FindSetBit(candidates));
+        else
+            fallback = BoardUtil::RandomEmptyCell(pos);
+    }
+    return fallback;
 }
 
