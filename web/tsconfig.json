{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true,
    // Vite does the transpiling; tsc is only ever a type check here. Without
    // this it emits .js beside every .tsx, and vite then resolves the stale
    // emitted file instead of the source — which breaks the dev server the
    // moment those files are cleaned up under it.
    "noEmit": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
